{
  "name": "rest-express",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx --watch server/index.ts",
    "dev:server": "NODE_ENV=development tsx --watch server/index.ts",
    "logs": "tail -f logs/collector.log",
    "logs:last": "tail -200 logs/collector.log",
    "logs:count": "wc -l logs/collector.log",
    "health": "tsx scripts/check_collection_health.ts",
    "coverage": "tsx scripts/measure_coverage.ts",
    "build-catalog": "tsx scripts/build_stratified_catalog.ts",
    "canary": "tsx scripts/credit_canary.ts",
    "anchor-probe": "tsx scripts/anchor_probe.ts",
    "gate0": "tsx scripts/gate0_budget_report.ts",
    "refill": "tsx scripts/refill_credits.ts",
    "export": "tsx scripts/export_flight_data.ts",
    "build": "tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "v39:repo-intake": "echo 'REPO-INTAKE: Run git status, git log, and inventory production paths'",
    "v39:migrate:check": "echo 'MIGRATE-CHECK: Verify fresh/upgrade/repeat migration passes'",
    "v39:test:offline": "vitest run tests/",
    "v39:test:full": "vitest run",
    "v39:typecheck": "tsc --noEmit",
    "v39:lint": "echo 'LINT: No linter configured yet'",
    "v39:build": "tsx script/build.ts",
    "v39:registry:check": "echo 'REGISTRY-CHECK: Verify all binding config is owned'",
    "v39:traceability:check": "echo 'TRACEABILITY-CHECK: Verify requirement/code reverse counts'",
    "v39:scanner": "tsx scripts/v39_preflight_consistency.ts",
    "v39:preflight": "tsx scripts/v39_preflight_consistency.ts",
    "v39:gate0:inspect": "tsx scripts/gate0_evidence_gather.ts",
    "v39:security:verify": "echo 'SECURITY: Verify retention/security lifecycle (AUTH-gated)'",
    "v39:gate1:coverage": "tsx scripts/measure_coverage.ts",
    "v39:reference:freeze": "echo 'REFERENCE-FREEZE: Freeze traffic/region source rules (offline artifact)'",
    "v39:frame:build": "tsx scripts/build_stratified_catalog.ts",
    "v39:preprobe:freeze": "echo 'PREPROBE-FREEZE: Freeze shortlist/replacements/protocol (offline artifact)'",
    "v39:smoke:safety": "echo 'SAFETY-SMOKE: Bounded production-path test — REQUIRES exact AUTH'",
    "v39:probe:stage1": "tsx scripts/anchor_probe.ts --stage 1",
    "v39:probe:stage2": "tsx scripts/anchor_probe.ts --stage 2",
    "v39:gate3:canary": "tsx scripts/credit_canary.ts",
    "v39:gate05:pilot": "echo 'GATE0.5: Dedicated provider/content/clock pilot — REQUIRES exact AUTH'",
    "v39:gate4:live-check": "echo 'GATE4: Cap/failure state machine + live reconciliation — REQUIRES exact AUTH'",
    "v39:gate5:population": "echo 'GATE5: Population/census validation — REST units may be consumed; REQUIRES AUTH'",
    "v39:calendar:solve": "tsx scripts/calendar_solve.ts",
    "v39:freeze": "echo 'FREEZE: Write final manifest (offline)'",
    "v39:phase6:start": "echo 'PHASE6-START: Requires separate AUTH + frozen manifest hash — REFUSES without it'",
    "v39:phase6:pause": "echo 'PHASE6-PAUSE: Safety pause (must be immediately available)'",
    "v39:phase6:status": "echo 'PHASE6-STATUS: Read balances/subscriptions/watchdog state'",
    "v39:reports:index": "echo 'REPORTS-INDEX: List evidence references/hashes'"
  },
