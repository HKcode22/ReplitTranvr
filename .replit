modules = ["nodejs-20", "bash", "python-3.12"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[agent]
expertMode = true
integrations = ["stripe:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "V39_CALLBACK_ONLY_RUNTIME=1 V39_WORKSPACE_RUNTIME_OWNER_MODE=replit-managed-project ./node_modules/.bin/tsx server/phase2gCallbackOnly.ts"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["env", "V39_CALLBACK_ONLY_RUNTIME=1", "V39_WORKSPACE_RUNTIME_OWNER_MODE=replit-published-deployment", "V39_RUNTIME_DURABILITY_CLASS=autoscale", "node", "dist/index.mjs"]
build = ["env", "V39_CALLBACK_ONLY_BUILD=1", "npm", "run", "build"]

[userenv]

[userenv.shared]
V39_PROVIDER_BLOB_MODE = "required"
ADB_AUTO_COLLECT = "false"
SENDGRID_FROM_EMAIL = "hello@travnr.com"
V39_DATABASE_TARGET_CONFIRM = "production"
V39_PROVIDER_BLOB_BUCKET_ID = "replit-objstore-5aa4d2c4-399b-4933-9acf-0292f79d6d59"

[objectStorage]
defaultBucketID = "replit-objstore-5aa4d2c4-399b-4933-9acf-0292f79d6d59"
