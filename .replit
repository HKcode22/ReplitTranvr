modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[agent]
expertMode = true
integrations = ["stripe:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["node", "dist/index.mjs"]
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
SENDGRID_FROM_EMAIL = "hello@travnr.com"
V39_PROVIDER_BLOB_BUCKET_ID = "replit-objstore-89d08290-bfed-4ba9-ab3a-517a47e8095f"
V39_PROVIDER_BLOB_MODE = "required"
V39_PUBLIC_WEBHOOK_BASE_URL = "https://travnr.com"
ADB_AUTO_COLLECT = "false"
V39_DATABASE_TARGET_CONFIRM = "production"
WEBHOOK_BASE_URL = "https://travnr.com/"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
